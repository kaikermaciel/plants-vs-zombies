<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lawn Defense Portal</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <style>
        body { 
            background-color: #1a1a1a; /* Um fundo escuro combina muito mais com o jogo */
            color: #ffffff;
        }
        .navbar-brand { font-weight: bold; color: #4caf50 !important; }
        .card { background-color: #2d2d2d; color: #ffffff; }
        .form-control, .form-select { background-color: #3d3d3d; color: #ffffff; border: 1px solid #555; }
        .form-control:focus, .form-select:focus { background-color: #4d4d4d; color: #ffffff; border-color: #4caf50; box-shadow: 0 0 0 0.25rem rgba(76, 175, 80, 0.25); }
        .text-dark { color: #ffffff !important; }
        .text-muted { color: #b0b0b0 !important; }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom border-secondary">
        <div class="container">
            <a class="navbar-brand" href="/">🌻 Defensores do DOM</a>
            <div class="navbar-nav ms-auto">
                <a class="nav-link" href="/about">Sobre</a>
                
                {{#if userLogged}}
                    <a class="nav-link fw-bold text-success" href="/">Jogar</a>
                    <a class="nav-link" href="/ranking">Ranking</a>
                    <a class="nav-link text-danger" href="/logout">Sair</a>
                {{else}}
                    <a class="nav-link" href="/login">Login</a>
                    <a class="nav-link" href="/signup">Criar Conta</a>
                {{/if}}
            </div>
        </div>
    </nav>

    <div class="container my-5">
        {{{body}}}
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>