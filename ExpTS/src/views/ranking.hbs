<div class="card p-4 shadow-sm border-0">
    <h1 class="text-center mb-4 text-success">🏆 Hall da Fama - TOP 10</h1>
    <p class="text-muted text-center mb-4">Veja as maiores pontuações registradas em tempo real no servidor da UFAM</p>

    <table class="table table-striped table-hover text-center align-middle">
        <thead class="table-dark">
            <tr>
                <th scope="col">Posição</th>
                <th scope="col">Jogador</th>
                <th scope="col">E-mail</th>
                <th scope="col">Onda Máxima Alcançada</th>
                <th scope="col">Data do Registro</th>
            </tr>
        </thead>
        <tbody>
            {{#each sessions}}
                <tr>
                    <td class="fw-bold text-primary">#{{@index}}</td>
                    <td class="fw-bold">{{this.user.fullname}}</td>
                    <td>{{this.user.email}}</td>
                    <td><span class="badge bg-success p-2 fs-6">{{this.score}} 🌊</span></td>
                    <td class="text-muted small">{{this.createdAt}}</td>
                </tr>
            {{/each}}
        </tbody>
    </table>
</div>